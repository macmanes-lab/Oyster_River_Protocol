+####
+sub touch_files {
+    # checkpoints: Perl rather than a 'touch' process per file
+    foreach my $file (@_) {
+        open(my $ofh, ">>", $file) or confess "Error, cannot touch $file: $!";
+        close $ofh;
+        utime(undef, undef, $file) or confess "Error, cannot touch $file: $!";
+    }
+    return;
+}
+
+####
+sub mkdir_p {
+    my ($dir) = @_;
+    unless (-d $dir) {
+        File::Path::make_path($dir);
+        -d $dir or confess "Error, cannot mkdir $dir";
+    }
+    return;
+}
+
+####
+sub fasta_has_at_least {
+    my ($file, $min_records) = @_;
+    open(my $fh, $file) or return 0;
+    my $count = 0;
+    while (<$fh>) {
+        if (/^>/ && ++$count >= $min_records) {
+            close $fh;
+            return 1;
+        }
+    }
+    close $fh;
+    return 0;
+}
+
