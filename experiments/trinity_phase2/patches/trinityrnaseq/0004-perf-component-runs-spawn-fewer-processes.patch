From 50d83154811bbc173e5f8eecff21185ab5199e7b Mon Sep 17 00:00:00 2001
From: macmanes <macmanes@gmail.com>
Date: Mon, 5 Oct 2026 16:14:04 -0400
Subject: [PATCH 4/5] perf: component runs spawn fewer processes

- PATH lookups in Perl instead of sh -c command -v
- --trinity_complete runs skip the tool version probes the parent already did
- sort --parallel probe made once per run tree (TRINITY_SORT_HAS_PARALLEL)
- touch / mkdir -p / Pipeliner checkpoints in Perl
- component runs call bowtie2-build-s / bowtie2-align-s directly
- read-pair scaffolding skipped when fewer than two contigs pass min100
---
 PerlLib/COMMON.pm    |  32 +++++++++---
 PerlLib/Pipeliner.pm |   7 +--
 Trinity              | 121 ++++++++++++++++++++++++++++++++-----------
 3 files changed, 120 insertions(+), 40 deletions(-)

diff --git a/PerlLib/COMMON.pm b/PerlLib/COMMON.pm
index ff5a394..87689ec 100644
--- a/PerlLib/COMMON.pm
+++ b/PerlLib/COMMON.pm
@@ -13,14 +13,17 @@ sub get_sort_exec {
     # check it like so:
     #  perl -MCOMMON -e 'print COMMON::get_sort_exec(4);'
 
-    my $sort_exec = `sh -c "command -v sort"`;
-    unless ($sort_exec =~ /\w/) {
+    my $sort_exec = &find_in_path("sort");
+    unless ($sort_exec) {
         confess "Error, cannot find sort utility";
     }
-    $sort_exec =~ s/\s//g;
-    
-    my $help_text = `$sort_exec --help`;  
-    if ($help_text =~ m|--parallel|) {
+
+    # probed once; the phase-2 Trinity runs inherit the answer through the environment
+    unless (defined $ENV{TRINITY_SORT_HAS_PARALLEL}) {
+        my $help_text = `$sort_exec --help`;
+        $ENV{TRINITY_SORT_HAS_PARALLEL} = ($help_text =~ m|--parallel|) ? 1 : 0;
+    }
+    if ($ENV{TRINITY_SORT_HAS_PARALLEL}) {
         ## could do simple versioning check, but I don't remember which version started using parallel
         $sort_exec = "$sort_exec --parallel=$num_threads";
     }
@@ -28,4 +31,21 @@ sub get_sort_exec {
     return($sort_exec);
 }
 
+####
+sub find_in_path {
+    my ($prog) = @_;
+
+    # like 'command -v', without forking a shell: phase 2 runs this tens of
+    # thousands of times
+    if ($prog =~ m|/|) {
+        return (-f $prog && -x _) ? $prog : undef;
+    }
+    foreach my $dir (split(/:/, $ENV{PATH} || "")) {
+        next unless length($dir);
+        my $path = "$dir/$prog";
+        return $path if (-f $path && -x _);
+    }
+    return undef;
+}
+
 1; #EOM
