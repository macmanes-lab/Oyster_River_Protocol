         KmerAlignCoreRecordStore & s = t[j];
@@ -111,8 +148,9 @@ void KmerAlignCore::AddData(const vecDNAVector & bases, const vecNumVector & tag
                 int n = m_pTrans->BasesToNumber(b, k);
                 if (n >= 0) {
                     KmerAlignCoreRecordStore & s = t[n];
